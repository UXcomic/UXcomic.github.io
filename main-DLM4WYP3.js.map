            {
              "type": "text",
              "text": {
                "content": "Thế dưới",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Thế dưới",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": ": Là khi một bên gặp bất lợi hoặc có ít lựa chọn hơn trong đàm phán. Một bên có \"thế yếu\" nếu họ có ít thông tin, ít khả năng ảnh hưởng, hoặc phụ thuộc vào kết quả hơn bên còn lại.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": ": Là khi một bên gặp bất lợi hoặc có ít lựa chọn hơn trong đàm phán. Một bên có \"thế yếu\" nếu họ có ít thông tin, ít khả năng ảnh hưởng, hoặc phụ thuộc vào kết quả hơn bên còn lại.",
              "href": null
            }
          ],
          "color": "default"
        }
