        "type": "numbered_list_item",
        "numbered_list_item": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Khi bước chân vào công ty hoặc tham gia vào lĩnh vực ngành nào đó, mình phải hiểu rõ “luật chơi” các thành viên của nơi mình thuộc về.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Khi bước chân vào công ty hoặc tham gia vào lĩnh vực ngành nào đó, mình phải hiểu rõ “luật chơi” các thành viên của nơi mình thuộc về.",
              "href": null
