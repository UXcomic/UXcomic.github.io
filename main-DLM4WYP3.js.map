        "type": "bulleted_list_item",
        "bulleted_list_item": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Nếu tự hỏi tại sao các thiết kế design từ Apple lại tuyệt vời đến thế.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
