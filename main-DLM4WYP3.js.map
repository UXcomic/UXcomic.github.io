                "code": false,
                "color": "default"
              },
              "plain_text": "“Quan” (觀) trong tiếng Hán Việt nghĩa là: cách nhìn, quan điểm, quan niệm. Nó giống như chữ “",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "framing",
                "link": {
                  "url": "https://en.wikipedia.org/wiki/Framing_(social_sciences)"
