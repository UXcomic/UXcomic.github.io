        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Cũng hơi xấu hổ khi phải thú thật là mình chưa nghe đến khái niệm này cho đến những năm gần đây, lần đầu tiên mình nghe là trong một cuộc phỏng vấn, tất nhiên khi bạn không biết về nó thì cách bạn làm cũng sẽ rất loay hoay & kết quả dĩ nhiên là tệ.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Cũng hơi xấu hổ khi phải thú thật là mình chưa nghe đến khái niệm này cho đến những năm gần đây, lần đầu tiên mình nghe là trong một cuộc phỏng vấn, tất nhiên khi bạn không biết về nó thì cách bạn làm cũng sẽ rất loay hoay & kết quả dĩ nhiên là tệ.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
