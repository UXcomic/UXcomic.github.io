      {
        "object": "block",
        "id": "1775d164-78d8-8056-9a69-e66e50754a5e",
        "parent": {
          "type": "page_id",
          "page_id": "1225d164-78d8-80db-8d9b-e6cc64d11314"
        },
        "created_time": "2025-01-10T02:21:00.000Z",
        "last_edited_time": "2025-05-25T11:17:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Đừng quên diagram hay toán thì cũng là một artifact, và nhiệm vụ chính của chúng là để hình dung được mối liên hệ giữa mọi thứ >> hãy thử dùng nó cho nhiều tính huống, luôn tìm cách kiểm chứng mức độ hiệu quả của nó >> tìm ra lỗ hỏng & cải thiện. Chỉ khi nó apply được đúng cho nhiều ngữ cảnh, nó mới trở nên có giá trị cho bản thân, vì sao? vì mình đang cầm trong tay một mental model để tăng hiệu quả xử lý thông tin, hiệu quả = nhanh * đúng * ít sức.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Đừng quên diagram hay toán thì cũng là một artifact, và nhiệm vụ chính của chúng là để hình dung được mối liên hệ giữa mọi thứ >> hãy thử dùng nó cho nhiều tính huống, luôn tìm cách kiểm chứng mức độ hiệu quả của nó >> tìm ra lỗ hỏng & cải thiện. Chỉ khi nó apply được đúng cho nhiều ngữ cảnh, nó mới trở nên có giá trị cho bản thân, vì sao? vì mình đang cầm trong tay một mental model để tăng hiệu quả xử lý thông tin, hiệu quả = nhanh * đúng * ít sức.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
