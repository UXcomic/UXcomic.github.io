      {
        "object": "block",
        "id": "1685d164-78d8-8083-978f-d8aab3b0febc",
        "parent": {
          "type": "page_id",
          "page_id": "32cbe568-c34b-4255-a408-f2a2e6227bb2"
        },
        "created_time": "2024-12-26T02:21:00.000Z",
        "last_edited_time": "2024-12-28T03:41:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Tam quan lý giải cho việc hình thành nên mindset, thái độ & hành vi. Khi nhắc đến hiểu user, theo như hình màu hồng ở trên, cái quan trọng nhất là hiểu “Why they do it?” >> có nghĩa là ta phải tìm hiểu tam quan của họ, biết được background của họ, môi trường sống của họ ra sao, bản chất con người họ (họ đang đề cao giá trị gì, họ có niềm tin gì, họ có xu hướng hành vi ra sao), figure out cái gì tác động lên cách định hình suy nghĩ đó.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Tam quan lý giải cho việc hình thành nên mindset, thái độ & hành vi. Khi nhắc đến hiểu user, theo như hình màu hồng ở trên, cái quan trọng nhất là hiểu “Why they do it?” >> có nghĩa là ta phải tìm hiểu tam quan của họ, biết được background của họ, môi trường sống của họ ra sao, bản chất con người họ (họ đang đề cao giá trị gì, họ có niềm tin gì, họ có xu hướng hành vi ra sao), figure out cái gì tác động lên cách định hình suy nghĩ đó.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
