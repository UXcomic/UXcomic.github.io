      {
        "object": "block",
        "id": "1395d164-78d8-8050-816e-c0df37c5f11f",
        "parent": {
          "type": "page_id",
          "page_id": "bcb5ee9a-8951-4932-8a46-9ca5ffafc079"
        },
        "created_time": "2024-11-09T07:01:00.000Z",
        "last_edited_time": "2024-11-10T01:44:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Vì digital product cơ bản là công nghệ thông tin, mà thông tin ảnh hưởng đến cách con người suy nghĩ và hành động, yếu tố này rất liên đới đến tâm lý. Và nó còn đặc biệt hữu ích khi bạn thiết kế cho consumer product, vì product thành công ngoài việc đảm bảo về utility, functionality mà còn phải khiến user khao khát, yêu thích nó.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Vì digital product cơ bản là công nghệ thông tin, mà thông tin ảnh hưởng đến cách con người suy nghĩ và hành động, yếu tố này rất liên đới đến tâm lý. Và nó còn đặc biệt hữu ích khi bạn thiết kế cho consumer product, vì product thành công ngoài việc đảm bảo về utility, functionality mà còn phải khiến user khao khát, yêu thích nó.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1395d164-78d8-801b-ab01-c7972b8d2a36",
        "parent": {
          "type": "page_id",
          "page_id": "bcb5ee9a-8951-4932-8a46-9ca5ffafc079"
        },
        "created_time": "2024-11-09T06:45:00.000Z",
        "last_edited_time": "2024-11-10T01:45:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
