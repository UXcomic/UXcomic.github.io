        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Điều chỉnh thế",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Điều chỉnh thế",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": ": Khi đàm phán tiến triển, các yếu tố \"thế\" có thể thay đổi dựa trên cách các bên phản ứng, điều chỉnh thông tin, hoặc thay đổi chiến lược. Người đàm phán giỏi là người biết cách linh hoạt điều chỉnh thế của mình, đôi khi bằng cách giảm kỳ vọng của đối phương hoặc làm nổi bật các lợi ích chung.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": ": Khi đàm phán tiến triển, các yếu tố \"thế\" có thể thay đổi dựa trên cách các bên phản ứng, điều chỉnh thông tin, hoặc thay đổi chiến lược. Người đàm phán giỏi là người biết cách linh hoạt điều chỉnh thế của mình, đôi khi bằng cách giảm kỳ vọng của đối phương hoặc làm nổi bật các lợi ích chung.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
