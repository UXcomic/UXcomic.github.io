        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Đã bao giờ bạn thấy bí bí trong lúc cố gắng thuyết phục ai đó về idea của bạn, hoặc ngược lại có khi ai đó thuyết phục bạn có khi mình đồng ý ngay, có khi lại chẳng thèm nghe. Vậy thuyết phục hoạt động ra sao?",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Đã bao giờ bạn thấy bí bí trong lúc cố gắng thuyết phục ai đó về idea của bạn, hoặc ngược lại có khi ai đó thuyết phục bạn có khi mình đồng ý ngay, có khi lại chẳng thèm nghe. Vậy thuyết phục hoạt động ra sao?",
