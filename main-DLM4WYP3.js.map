        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Qua ví dụ trên bạn thấy product design cân nhắc đến solution không còn gói gọn trong việc thiết kế cách user tương tác, nhìn giao diện như thế nào, hay chỉ trong phạm vi feature, góc nhìn đã được mở rộng ra, việc hình thành 1 giải pháp phải cần có tính chiến lược và sự cân nhắc ở nhiều khía cạnh hơn.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Qua ví dụ trên bạn thấy product design cân nhắc đến solution không còn gói gọn trong việc thiết kế cách user tương tác, nhìn giao diện như thế nào, hay chỉ trong phạm vi feature, góc nhìn đã được mở rộng ra, việc hình thành 1 giải pháp phải cần có tính chiến lược và sự cân nhắc ở nhiều khía cạnh hơn.",
              "href": null
            }
          ],
          "color": "default"
        }
