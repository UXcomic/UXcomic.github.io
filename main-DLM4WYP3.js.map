      {
        "object": "block",
        "id": "1655d164-78d8-80bd-b9fe-e9a5743e30bd",
        "parent": {
          "type": "page_id",
          "page_id": "a8c82bf1-5c5b-4f4d-b945-cbdb31c819b7"
        },
        "created_time": "2024-12-23T08:10:00.000Z",
        "last_edited_time": "2024-12-26T10:45:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Trước mắt một điểm chung về mindset, tâm thế đó là tất cả những thứ này nằm trong đầu chúng ta, thuộc về nội tại & không dễ quan sát (ngay cả với chính chúng ta chứ chưa kể đến người khác), chúng một cách vô tình hay cố ý chúng ảnh hưởng đến hành vi & thái độ của ta. Mà hành vi, thái độ là cách bạn tương tác với cuộc sống, thông qua tương tác này, ta sẽ nhận được phản hồi gì đó từ phía cuộc sống.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Trước mắt một điểm chung về mindset, tâm thế đó là tất cả những thứ này nằm trong đầu chúng ta, thuộc về nội tại & không dễ quan sát (ngay cả với chính chúng ta chứ chưa kể đến người khác), chúng một cách vô tình hay cố ý chúng ảnh hưởng đến hành vi & thái độ của ta. Mà hành vi, thái độ là cách bạn tương tác với cuộc sống, thông qua tương tác này, ta sẽ nhận được phản hồi gì đó từ phía cuộc sống.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
