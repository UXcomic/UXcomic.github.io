        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Vậy câu hỏi đặt ra là liệu đâu là giá trị cao nhất cho một người có thâm niên lâu ở một công ty trong khi thế hệ sau có sức trẻ, nhiệt huyết, có kiến thức & skill, thậm chí tư duy tốt hơn.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Vậy câu hỏi đặt ra là liệu đâu là giá trị cao nhất cho một người có thâm niên lâu ở một công ty trong khi thế hệ sau có sức trẻ, nhiệt huyết, có kiến thức & skill, thậm chí tư duy tốt hơn.",
