        "in_trash": false,
        "type": "callout",
        "callout": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Vậy đâu mới là process mình cần nắm để có nhìn đúng đắn nhất cho công việc của một ux/ui designer?",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Vậy đâu mới là process mình cần nắm để có nhìn đúng đắn nhất cho công việc của một ux/ui designer?",
              "href": null
            }
          ],
          "icon": {
            "type": "emoji",
            "emoji": "🤨"
          },
          "color": "gray_background"
        }
      },
      {
        "object": "block",
        "id": "1475d164-78d8-8091-bb35-da3c29ec4376",
        "parent": {
          "type": "page_id",
          "page_id": "1445d164-78d8-805b-b388-e24b5f13cccb"
        },
        "created_time": "2024-11-23T03:09:00.000Z",
        "last_edited_time": "2024-12-25T02:00:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Một hôm mình tìm được bài viết nói về khái niệm ",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Một hôm mình tìm được bài viết nói về khái niệm ",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "3 diamond product process",
                "link": {
                  "url": "https://nealcabage.com/framework/product-management-process/"
                }
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "3 diamond product process",
              "href": "https://nealcabage.com/framework/product-management-process/"
            },
            {
              "type": "text",
              "text": {
                "content": ", mình thấy nó cung cấp cái hiểu rõ ràng, tổng quát hơn cho việc hiểu quy trình phát triển sản phẩm cho một công ty, từ đó hiểu công việc ux/ui thường ngày đang thực sự đang nằm ở đâu trong đó.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": ", mình thấy nó cung cấp cái hiểu rõ ràng, tổng quát hơn cho việc hiểu quy trình phát triển sản phẩm cho một công ty, từ đó hiểu công việc ux/ui thường ngày đang thực sự đang nằm ở đâu trong đó.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1495d164-78d8-8020-9981-dfe68ab13e81",
        "parent": {
          "type": "page_id",
          "page_id": "1445d164-78d8-805b-b388-e24b5f13cccb"
        },
        "created_time": "2024-11-25T02:02:00.000Z",
        "last_edited_time": "2025-01-12T02:55:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Note: để có khách quan hơn thì mình phải share chút về bối cảnh hiện tại - công ty product big corp ở phase mature. Vì thực tế scope của ux/ui designer sẽ tuỳ thuộc vào mô hình công ty bạn đang làm + giai đoạn sản phẩm + UX maturity. There’s no one size fit all.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": true,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Note: để có khách quan hơn thì mình phải share chút về bối cảnh hiện tại - công ty product big corp ở phase mature. Vì thực tế scope của ux/ui designer sẽ tuỳ thuộc vào mô hình công ty bạn đang làm + giai đoạn sản phẩm + UX maturity. There’s no one size fit all.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
