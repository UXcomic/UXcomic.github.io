          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "UI Pattern mang nghĩa cần",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "UI Pattern mang nghĩa cần",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": " chuẩn hoá cách trình bày thông tin và thành phần giao diện (bố cục, phân cấp và hiển thị)",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": " chuẩn hoá cách trình bày thông tin và thành phần giao diện (bố cục, phân cấp và hiển thị)",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": " — giúp người dùng dễ nhìn – hiểu – thao tác một cách nhất quán và quen thuộc. Nó giống như “Từ điển thiết kế” chung cho các bên giao tiếp hiệu quả giữa các thành viên trong team design và dev.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": " — giúp người dùng dễ nhìn – hiểu – thao tác một cách nhất quán và quen thuộc. Nó giống như “Từ điển thiết kế” chung cho các bên giao tiếp hiệu quả giữa các thành viên trong team design và dev.",
              "href": null
