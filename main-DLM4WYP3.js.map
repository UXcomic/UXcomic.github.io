          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Hiểu được user cũng là một cách để hiểu được mình, ta phải dig deep hơn vào khái niệm tam quan thay vì chỉ quan sát hành vi & thái độ.",
                "link": null
              },
              "annotations": {
