              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "mới lạ",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": ", bạn xử lý thông tin trên dữ liệu thô thu thập được từ các giác quan để hình thành nên một ý nghĩa cụ thể nào đó. Ví dụ lần đầu bạn sử dụng photoshop phải làm quen với từng tool, function một. Quá trình này bắt đầu từ giác quan đến ý nghĩa, nó mang tính phân tích & xử lý chậm hơn.",
                "link": null
              },
              "annotations": {
