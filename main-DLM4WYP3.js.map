      {
        "object": "block",
        "id": "1fc5d164-78d8-80d6-a661-fad3768a1627",
        "parent": {
          "type": "page_id",
          "page_id": "1fc5d164-78d8-80ca-a762-d0d1658b5eec"
        },
        "created_time": "2025-05-23T06:28:00.000Z",
        "last_edited_time": "2025-06-11T06:35:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "bulleted_list_item",
        "bulleted_list_item": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Mình biết nó đến mức độ nào. Mình có cái nhìn hệ thống về nó không (nó được tạo thành như thế nào, nó có mấy loại, giữa nó và những thứ khác tác động thế nào…, nguyên lý hoạt động, bản chất nó là gì). Tip luyện tập ý thức thêm những thứ đã biết một cách sâu sắc hơn là research về “phương pháp luận”, “framework”.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Mình biết nó đến mức độ nào. Mình có cái nhìn hệ thống về nó không (nó được tạo thành như thế nào, nó có mấy loại, giữa nó và những thứ khác tác động thế nào…, nguyên lý hoạt động, bản chất nó là gì). Tip luyện tập ý thức thêm những thứ đã biết một cách sâu sắc hơn là research về “phương pháp luận”, “framework”.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1fc5d164-78d8-8054-933e-ffac67433803",
        "parent": {
          "type": "page_id",
          "page_id": "1fc5d164-78d8-80ca-a762-d0d1658b5eec"
        },
        "created_time": "2025-05-23T06:29:00.000Z",
        "last_edited_time": "2025-06-11T06:36:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "bulleted_list_item",
        "bulleted_list_item": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Đừng tưởng mình biết hết, sẽ luôn có gì đó bạn chưa biết trong cái thứ bạn biết >> ta gọi đây là những điểm mù. Người thông minh sẽ biết cách để hạn chế điểm mù này, ví dụ như hỏi thêm ý kiến người khác, tự phản biện, nhìn ở nhiều angle, tiếp nhận góc nhìn trái chiều, nhìn sâu thêm hoặc rộng thêm 1 level nữa thì nó là gì…",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Đừng tưởng mình biết hết, sẽ luôn có gì đó bạn chưa biết trong cái thứ bạn biết >> ta gọi đây là những điểm mù. Người thông minh sẽ biết cách để hạn chế điểm mù này, ví dụ như hỏi thêm ý kiến người khác, tự phản biện, nhìn ở nhiều angle, tiếp nhận góc nhìn trái chiều, nhìn sâu thêm hoặc rộng thêm 1 level nữa thì nó là gì…",
              "href": null
            }
          ],
          "color": "default"
        }
