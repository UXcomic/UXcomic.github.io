      {
        "object": "block",
        "id": "16c5d164-78d8-806c-9d40-e1ea3cccf061",
        "parent": {
          "type": "page_id",
          "page_id": "1575d164-78d8-8024-860e-d419e25be8bc"
        },
        "created_time": "2024-12-30T01:51:00.000Z",
        "last_edited_time": "2024-12-30T01:53:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Người hướng nội thường tập trung vào thế giới nội tâm, thích sự yên tĩnh và có xu hướng suy nghĩ sâu sắc trước khi hành động. Họ thường cảm thấy thoải mái khi ở một mình hoặc trong các nhóm nhỏ thân thiết, và dễ bị cạn năng lượng khi giao tiếp xã hội quá nhiều.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Người hướng nội thường tập trung vào thế giới nội tâm, thích sự yên tĩnh và có xu hướng suy nghĩ sâu sắc trước khi hành động. Họ thường cảm thấy thoải mái khi ở một mình hoặc trong các nhóm nhỏ thân thiết, và dễ bị cạn năng lượng khi giao tiếp xã hội quá nhiều.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "16c5d164-78d8-80ad-ac85-e1de24f4a9e8",
        "parent": {
          "type": "page_id",
          "page_id": "1575d164-78d8-8024-860e-d419e25be8bc"
