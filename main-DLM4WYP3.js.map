      {
        "object": "block",
        "id": "10f5d164-78d8-815d-bb23-d81f1b549306",
        "parent": {
          "type": "page_id",
          "page_id": "10f5d164-78d8-80da-be21-ece791f46d2e"
        },
        "created_time": "2024-09-28T07:50:00.000Z",
        "last_edited_time": "2025-02-18T01:58:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "4000 năm trước công nguyên, đã có khái niệm về phong thuỷ, nó là học thuyết được sinh ra ở đất nước Trung Quốc, phong thuỷ chuyên nghiên cứu về sự tác động của các yếu tố môi trường đến đời sống, sức khỏe, tài vận và sự hài hòa của con người. Ví dụ: căn phòng có cửa sổ sẽ khiến bạn cảm thấy đỡ tù túng hơn, tường sơn màu sáng để bạn mắt ta dễ điều hướng & tập trung vào các vật dụng hơn… >> bổ trợ cho khái niệm context of use trong product design, sự tương tác giữa con người với cảnh quan xung quanh.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "4000 năm trước công nguyên, đã có khái niệm về phong thuỷ, nó là học thuyết được sinh ra ở đất nước Trung Quốc, phong thuỷ chuyên nghiên cứu về sự tác động của các yếu tố môi trường đến đời sống, sức khỏe, tài vận và sự hài hòa của con người. Ví dụ: căn phòng có cửa sổ sẽ khiến bạn cảm thấy đỡ tù túng hơn, tường sơn màu sáng để bạn mắt ta dễ điều hướng & tập trung vào các vật dụng hơn… >> bổ trợ cho khái niệm context of use trong product design, sự tương tác giữa con người với cảnh quan xung quanh.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
