      {
        "object": "block",
        "id": "48940ab1-c955-4db3-84a7-3ba832c6608c",
        "parent": {
          "type": "page_id",
          "page_id": "a8c82bf1-5c5b-4f4d-b945-cbdb31c819b7"
        },
        "created_time": "2024-12-23T08:06:00.000Z",
        "last_edited_time": "2024-12-26T01:33:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Chắc hẳn đâu đó bạn đã nghe qua “bạn này có mindset tốt”, “thái độ quan trọng hơn trình độ”, mình thì có nghe qua chữ “tâm thế” nữa nhưng ít người nói hơn, vậy chúng nó là gì & liệu có tác động gì vào cuộc sống?",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Chắc hẳn đâu đó bạn đã nghe qua “bạn này có mindset tốt”, “thái độ quan trọng hơn trình độ”, mình thì có nghe qua chữ “tâm thế” nữa nhưng ít người nói hơn, vậy chúng nó là gì & liệu có tác động gì vào cuộc sống?",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1655d164-78d8-8006-ad2a-c3ead14e67b9",
