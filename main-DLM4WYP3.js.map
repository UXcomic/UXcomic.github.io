              "plain_text": "mức độ giá trị ",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "giữa các tiền tệ này sẽ tuỳ thuộc vào cách nhìn nhận của đối phương, có người đánh giá tiền cao hơn, có người đánh giá thời gian cao hơn.",
                "link": null
              },
              "annotations": {
