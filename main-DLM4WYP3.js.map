        "type": "bulleted_list_item",
        "bulleted_list_item": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Deliberate and Cognitive Creativity",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Deliberate and Cognitive Creativity",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": ": sáng tạo này dựa trên kế hoạch và tư duy logic, sử dụng kiến thức và phân tích để giải quyết vấn đề một cách có chủ đích. Nó thường được áp dụng trong khoa học, kỹ thuật, và kinh doanh, ví dụ như việc Edison đã phát minh ra bóng đèn điện thông qua việc tiến hành hàng ngàn thử nghiệm có hệ thống với các vật liệu khác nhau để tìm ra dây tóc bóng đèn phù hợp.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": ": sáng tạo này dựa trên kế hoạch và tư duy logic, sử dụng kiến thức và phân tích để giải quyết vấn đề một cách có chủ đích. Nó thường được áp dụng trong khoa học, kỹ thuật, và kinh doanh, ví dụ như việc Edison đã phát minh ra bóng đèn điện thông qua việc tiến hành hàng ngàn thử nghiệm có hệ thống với các vật liệu khác nhau để tìm ra dây tóc bóng đèn phù hợp.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "db66c8c3-6dbf-486e-bb37-f6a9d7949857",
        "parent": {
          "type": "page_id",
          "page_id": "15e5d164-78d8-80c8-ac9e-ff1a29784a09"
