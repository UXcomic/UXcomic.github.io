        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Là một nhóm user có sự tương đồng về behavior, nhu cầu, động lực, thái độ khi tìm đến sản phẩm. Ví dụ: sản phẩm Zalo có nhóm dùng để trò chuyện với gia đình, nhóm dùng để làm việc, kết nối với khách hàng…hay có người thích lướt hàng trên Shopee hàng giờ nhưng có người lại chỉ ghé khi biết mình cần mua gì và chốt đơn rất nhanh…",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Là một nhóm user có sự tương đồng về behavior, nhu cầu, động lực, thái độ khi tìm đến sản phẩm. Ví dụ: sản phẩm Zalo có nhóm dùng để trò chuyện với gia đình, nhóm dùng để làm việc, kết nối với khách hàng…hay có người thích lướt hàng trên Shopee hàng giờ nhưng có người lại chỉ ghé khi biết mình cần mua gì và chốt đơn rất nhanh…",
              "href": null
