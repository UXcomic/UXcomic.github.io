        "created_time": "2025-01-04T03:51:00.000Z",
        "last_edited_time": "2025-01-04T03:52:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "\"Engineer-friendly\" trong design là một khái niệm đề cập đến việc thiết kế giao diện và sản phẩm theo cách giúp đội ngũ kỹ sư (developers) dễ dàng hiểu, triển khai, và phát triển sản phẩm. Một thiết kế được coi là engineer-friendly khi nó giảm thiểu sự mơ hồ, tối ưu quy trình làm việc giữa designer và developer, và đảm bảo rằng các giải pháp thiết kế có thể được thực thi hiệu quả về mặt kỹ thuật.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "\"Engineer-friendly\" trong design là một khái niệm đề cập đến việc thiết kế giao diện và sản phẩm theo cách giúp đội ngũ kỹ sư (developers) dễ dàng hiểu, triển khai, và phát triển sản phẩm. Một thiết kế được coi là engineer-friendly khi nó giảm thiểu sự mơ hồ, tối ưu quy trình làm việc giữa designer và developer, và đảm bảo rằng các giải pháp thiết kế có thể được thực thi hiệu quả về mặt kỹ thuật.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
