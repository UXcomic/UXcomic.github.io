        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Vâng, nó luôn là expectation đầu tiên của mọi người, thử xem nếu bạn cho ai đó biết bạn làm design, thường họ sẽ có xu hướng expect bạn có gu và làm được những thứ đẹp đẽ. Mình thấy chắc 10/10 người đều nghĩ vậy.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Vâng, nó luôn là expectation đầu tiên của mọi người, thử xem nếu bạn cho ai đó biết bạn làm design, thường họ sẽ có xu hướng expect bạn có gu và làm được những thứ đẹp đẽ. Mình thấy chắc 10/10 người đều nghĩ vậy.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1425d164-78d8-808a-af0a-ff763b52aa00",
        "parent": {
          "type": "page_id",
          "page_id": "ed40fd40-a318-4fd6-a63f-0067b4e54861"
        },
        "created_time": "2024-11-18T09:49:00.000Z",
