          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Mình xin giới thiệu chút, mình có background công việc trong graphic design, illustrator, sau đó mình chuyển sang lĩnh vực UX/UI, và chắc cũng như đa phần mọi người đó là học vài khoá, tự mày mò đọc blog để học hỏi thêm.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
