      {
        "object": "block",
        "id": "1705d164-78d8-80dd-aeae-c6507cd76530",
        "parent": {
          "type": "page_id",
          "page_id": "1705d164-78d8-8087-8fcc-e832cb1f677b"
        },
        "created_time": "2025-01-03T14:35:00.000Z",
        "last_edited_time": "2025-01-04T05:35:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Phía dev luôn muốn tối ưu tái sử dụng nhiều nhất có thể, và phía design mình cũng có concept giống vậy, đó là design system.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Phía dev luôn muốn tối ưu tái sử dụng nhiều nhất có thể, và phía design mình cũng có concept giống vậy, đó là design system.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1715d164-78d8-8009-acf7-edc656322389",
        "parent": {
          "type": "page_id",
          "page_id": "1705d164-78d8-8087-8fcc-e832cb1f677b"
        },
        "created_time": "2025-01-04T05:35:00.000Z",
        "last_edited_time": "2025-01-04T05:36:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Design system không những giúp tiết kiệm thời gian để build mà còn giúp thiết kế có tính consistent, một tính chất rất quan trọng trong UX. ",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Design system không những giúp tiết kiệm thời gian để build mà còn giúp thiết kế có tính consistent, một tính chất rất quan trọng trong UX. ",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1715d164-78d8-8082-b996-c78763d3de3b",
        "parent": {
          "type": "page_id",
          "page_id": "1705d164-78d8-8087-8fcc-e832cb1f677b"
        },
        "created_time": "2025-01-04T05:36:00.000Z",
