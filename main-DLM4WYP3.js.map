        "callout": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "We rarely see the constraints, pushback, perspectives, and objectives others are working with. We can hardly know whether the work was even meant for someone like us, or if the audience is an entirely different group of people with different beliefs, ways of seeing things, or needs.",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "We rarely see the constraints, pushback, perspectives, and objectives others are working with. We can hardly know whether the work was even meant for someone like us, or if the audience is an entirely different group of people with different beliefs, ways of seeing things, or needs.",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": " Readily jumping to any conclusions without first considering these aspects means we're shutting off and rejecting work that may otherwise actually be \"good” or even remarkable.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
