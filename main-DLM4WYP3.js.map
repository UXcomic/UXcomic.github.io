      {
        "object": "block",
        "id": "1685d164-78d8-8082-adb4-eaa0966d37e1",
        "parent": {
          "type": "page_id",
          "page_id": "a8c82bf1-5c5b-4f4d-b945-cbdb31c819b7"
        },
        "created_time": "2024-12-26T01:40:00.000Z",
        "last_edited_time": "2024-12-26T10:49:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "bulleted_list_item",
        "bulleted_list_item": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Khi gặp cùng 1 tình huống về thất bại , ta có thể “Tập trung vào sự phát triển, xem nó là cơ hội để học” (Growth mindset) hoặc “Tin vào sự cố định của năng lực, xem nó là bằng chứng cho giới hạn bản thân” (Fixed mindset). 2 niềm tin như 2 direction riêng biệt lèo lái mọi hành vi & thái độ của ta, người có growth mindset sẽ vui mừng vì học thêm được gì đó, người có fixed mindset sẽ buồn & tự trách bản thân.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Khi gặp cùng 1 tình huống về thất bại , ta có thể “Tập trung vào sự phát triển, xem nó là cơ hội để học” (Growth mindset) hoặc “Tin vào sự cố định của năng lực, xem nó là bằng chứng cho giới hạn bản thân” (Fixed mindset). 2 niềm tin như 2 direction riêng biệt lèo lái mọi hành vi & thái độ của ta, người có growth mindset sẽ vui mừng vì học thêm được gì đó, người có fixed mindset sẽ buồn & tự trách bản thân.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1685d164-78d8-8081-8dca-e397bfa7efdc",
        "parent": {
          "type": "page_id",
          "page_id": "a8c82bf1-5c5b-4f4d-b945-cbdb31c819b7"
        },
        "created_time": "2024-12-26T01:51:00.000Z",
        "last_edited_time": "2024-12-26T10:52:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
