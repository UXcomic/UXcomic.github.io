      {
        "object": "block",
        "id": "1625d164-78d8-80f0-9d2e-cb842bae049b",
        "parent": {
          "type": "page_id",
          "page_id": "12c5d164-78d8-80b5-82fb-dc48f1f4d4f8"
        },
        "created_time": "2024-12-20T10:46:00.000Z",
        "last_edited_time": "2025-01-01T00:51:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Tưởng tượng xem, thế hệ sau đang nỗ lực phấn đấu & tiếp cận với những kiến thức mới mỗi ngày, chắc chắn kiến thức đó sẽ up to date hơn & hay hơn, các khóa học cũng sát với thực tế hơn, chưa kể đến tích luỹ kinh nghiệm cũng có nhiều đường tắt hơn với thời đại thông tin như hiện nay…>> thế hệ sau “tiến hoá” nhanh hơn mình là điều chắc chắn xảy ra & nó là tốt, có vậy ngành nghề này mới phát triển được.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Tưởng tượng xem, thế hệ sau đang nỗ lực phấn đấu & tiếp cận với những kiến thức mới mỗi ngày, chắc chắn kiến thức đó sẽ up to date hơn & hay hơn, các khóa học cũng sát với thực tế hơn, chưa kể đến tích luỹ kinh nghiệm cũng có nhiều đường tắt hơn với thời đại thông tin như hiện nay…>> thế hệ sau “tiến hoá” nhanh hơn mình là điều chắc chắn xảy ra & nó là tốt, có vậy ngành nghề này mới phát triển được.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1625d164-78d8-8079-8f0b-fde6b811f980",
        "parent": {
          "type": "page_id",
