            {
              "type": "text",
              "text": {
                "content": "Về căn bản, thuyết phục cũng là một loại hình trong ",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Về căn bản, thuyết phục cũng là một loại hình trong ",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "giao tiếp,",
                "link": {
                  "url": "/1405d16478d8801faad4f558038c6ba3"
                }
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "giao tiếp,",
              "href": "/1405d16478d8801faad4f558038c6ba3"
            },
            {
              "type": "text",
              "text": {
                "content": " nên cũng cần follow các nguyên lý cơ bản như: hiểu đối phương, thông điệp rõ ràng, trình bày mạch lạc…",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": " nên cũng cần follow các nguyên lý cơ bản như: hiểu đối phương, thông điệp rõ ràng, trình bày mạch lạc…",
              "href": null
            }
          ],
