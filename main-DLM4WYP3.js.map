      {
        "object": "block",
        "id": "10f5d164-78d8-81e6-ab6e-e1487772cb64",
        "parent": {
          "type": "page_id",
          "page_id": "10f5d164-78d8-80da-be21-ece791f46d2e"
        },
        "created_time": "2024-09-28T07:50:00.000Z",
        "last_edited_time": "2024-12-28T05:16:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "500 năm trước công nguyên, Hy Lạp đã sử dụng các nguyên tắc công thái học để thiết kế công cụ và tổ chức nơi làm việc của họ. Công thái học là một môn học về khả năng, giới hạn của con người. Từ đó có thể tăng khả năng và tối ưu hóa điểm mạnh của con người, hay để bù trừ khiếm khuyết, để bảo vệ điểm yếu >> bổ trợ cho khái niệm Usability.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "500 năm trước công nguyên, Hy Lạp đã sử dụng các nguyên tắc công thái học để thiết kế công cụ và tổ chức nơi làm việc của họ. Công thái học là một môn học về khả năng, giới hạn của con người. Từ đó có thể tăng khả năng và tối ưu hóa điểm mạnh của con người, hay để bù trừ khiếm khuyết, để bảo vệ điểm yếu >> bổ trợ cho khái niệm Usability.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
