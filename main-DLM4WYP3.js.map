        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Để có thể đánh giá IA tốt sẽ có các cách tactics như: card sorting (cách user phân nhóm thông tin), tree testing (cách user điều hướng tìm kiếm thông tin nào đó), usability testing (chung chung về việc user có hiểu label & tìm kiếm thông tin không, cách sắp xếp có phù hợp với mental model của họ không)",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Để có thể đánh giá IA tốt sẽ có các cách tactics như: card sorting (cách user phân nhóm thông tin), tree testing (cách user điều hướng tìm kiếm thông tin nào đó), usability testing (chung chung về việc user có hiểu label & tìm kiếm thông tin không, cách sắp xếp có phù hợp với mental model của họ không)",
              "href": null
