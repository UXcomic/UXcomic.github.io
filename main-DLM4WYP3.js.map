      {
        "object": "block",
        "id": "1605d164-78d8-8008-b26c-f48f5635299f",
        "parent": {
          "type": "page_id",
          "page_id": "1605d164-78d8-80ad-9130-fe44c6663146"
        },
        "created_time": "2024-12-18T05:49:00.000Z",
        "last_edited_time": "2024-12-18T05:49:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "\"What is iPod? iPod is an MP3 music player that has CD-quality music and it plays all of the popular open formats of digital music: MP3, MP3 VBR, WAV, and AIFF. But that’s not the big deal. The big deal about iPod is it holds 1,000 songs. This is a quantum leap because for most people, it’s their entire music library. This is huge!\"",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "\"What is iPod? iPod is an MP3 music player that has CD-quality music and it plays all of the popular open formats of digital music: MP3, MP3 VBR, WAV, and AIFF. But that’s not the big deal. The big deal about iPod is it holds 1,000 songs. This is a quantum leap because for most people, it’s their entire music library. This is huge!\"",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1605d164-78d8-80b2-8d31-c50c6e755770",
        "parent": {
          "type": "page_id",
          "page_id": "1605d164-78d8-80ad-9130-fe44c6663146"
        },
        "created_time": "2024-12-18T05:49:00.000Z",
        "last_edited_time": "2024-12-18T05:49:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "\"iPod is the size of a deck of cards. It weighs only 6.5 ounces, and it fits in your pocket. iPod isn’t just a new way to listen to music. It’s a whole new way of experiencing music.\"",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "\"iPod is the size of a deck of cards. It weighs only 6.5 ounces, and it fits in your pocket. iPod isn’t just a new way to listen to music. It’s a whole new way of experiencing music.\"",
              "href": null
            }
          ],
          "color": "default"
        }
      },
