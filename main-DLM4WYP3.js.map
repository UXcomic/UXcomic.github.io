        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Có một tactic mình rất hay dùng khi design UX cho một feature, mình sẽ cố gắng suy nghĩ xem có những ",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Có một tactic mình rất hay dùng khi design UX cho một feature, mình sẽ cố gắng suy nghĩ xem có những ",
              "href": null
            },
            {
