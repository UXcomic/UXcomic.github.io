      {
        "object": "block",
        "id": "1505d164-78d8-80fd-adc1-e44173e68227",
        "parent": {
          "type": "page_id",
          "page_id": "1215d164-78d8-809d-89b0-e84bbf170b05"
        },
        "created_time": "2024-12-02T12:45:00.000Z",
        "last_edited_time": "2024-12-23T02:49:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Tuy nhiên trong thuyết phục, rất quan trọng việc dùng “ngôn ngữ” của đối phương,",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Tuy nhiên trong thuyết phục, rất quan trọng việc dùng “ngôn ngữ” của đối phương,",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": " có nghĩa là mình phải đặt mình ở vị thế của họ, hiểu lối suy nghĩ, mối quan tâm của họ là gì, cách họ sẽ diễn giải vấn đề như thế nào >> để lựa chọn hướng truyền đạt cho phù hợp, càng “gãi đúng chỗ ngứa” càng tốt.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
