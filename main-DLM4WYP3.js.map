            {
              "type": "text",
              "text": {
                "content": "Inclusivity",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Inclusivity",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": ": có nghĩa khuyến khích tất cả mọi người đều tham gia đóng góp, đặc biệt với những ai ngại chia sẻ. Ví dụ trong buổi brainstorm, bạn nói trước là không có ý tưởng nào ngu ngốc cả, không có sự đúng sai ở bước này, hãy để mọi người được im lặng note hết những idea trong đầu ra giấy trong vài phút & dán chúng lên bảng (tránh sự thảo luận khiến vài người không dám đóng góp hoặc bị ảnh hưởng ý kiến của nhau). Hoặc lúc dot voting thì nên làm dưới chế độ ẩn danh để mọi người thoải mái bình chọn & công tâm nhất.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": ": có nghĩa khuyến khích tất cả mọi người đều tham gia đóng góp, đặc biệt với những ai ngại chia sẻ. Ví dụ trong buổi brainstorm, bạn nói trước là không có ý tưởng nào ngu ngốc cả, không có sự đúng sai ở bước này, hãy để mọi người được im lặng note hết những idea trong đầu ra giấy trong vài phút & dán chúng lên bảng (tránh sự thảo luận khiến vài người không dám đóng góp hoặc bị ảnh hưởng ý kiến của nhau). Hoặc lúc dot voting thì nên làm dưới chế độ ẩn danh để mọi người thoải mái bình chọn & công tâm nhất.",
              "href": null
