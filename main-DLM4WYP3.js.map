        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Trước mắt hãy hiểu về term “interaction”, quá trình tương tác diễn ra khi con người {hành động-trigger} gì đó trên một {objects} thì có lại được một {phản hồi - feedback} gì đó. Quá trình này ta gọi là tương tác.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Trước mắt hãy hiểu về term “interaction”, quá trình tương tác diễn ra khi con người {hành động-trigger} gì đó trên một {objects} thì có lại được một {phản hồi - feedback} gì đó. Quá trình này ta gọi là tương tác.",
              "href": null
            }
          ],
          "color": "default"
        }
