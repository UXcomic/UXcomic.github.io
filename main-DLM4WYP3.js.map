        "type": "bulleted_list_item",
        "bulleted_list_item": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "UX maturity sẽ ảnh hưởng đến scope công việc của bạn, nên hãy aware với scope đó có phải đúng thứ mình muốn grow hay không. (ví dụ nếu bạn muốn chuyên sâu, theo hướng crafting skill thì công ty có UX maturity lv3 là hợp, nếu muốn bắt đầu đóng góp nhiều vào solution, vào strategy hãy lựa chọn công ty có UX maturity ở lv4 & 5).",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "UX maturity sẽ ảnh hưởng đến scope công việc của bạn, nên hãy aware với scope đó có phải đúng thứ mình muốn grow hay không. (ví dụ nếu bạn muốn chuyên sâu, theo hướng crafting skill thì công ty có UX maturity lv3 là hợp, nếu muốn bắt đầu đóng góp nhiều vào solution, vào strategy hãy lựa chọn công ty có UX maturity ở lv4 & 5).",
              "href": null
