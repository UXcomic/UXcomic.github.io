        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Tất cả các output của IA như labeling, structure, navigation… đều phải hợp lý với user, phù hợp với mental model của họ. Mình sẽ không muốn việc nói A nhưng user hiểu B, hoặc các bước sử dụng, tìm kiếm thông tin của user trên app lại khác hoàn toàn với cách họ hình dung, kì vọng. ",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Tất cả các output của IA như labeling, structure, navigation… đều phải hợp lý với user, phù hợp với mental model của họ. Mình sẽ không muốn việc nói A nhưng user hiểu B, hoặc các bước sử dụng, tìm kiếm thông tin của user trên app lại khác hoàn toàn với cách họ hình dung, kì vọng. ",
              "href": null
            }
          ],
          "color": "default"
        }
      },
