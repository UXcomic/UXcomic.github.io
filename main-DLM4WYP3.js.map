        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "numbered_list_item",
        "numbered_list_item": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Và khi luận điểm nào cũng có cái lý của nó, thì hãy tiếp tục đánh giá nó trên 1 ",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Và khi luận điểm nào cũng có cái lý của nó, thì hãy tiếp tục đánh giá nó trên 1 ",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "lớp quy chiếu thứ 2,",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "lớp quy chiếu thứ 2,",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": " chẳng hạn xét xem luận điểm nào phù hợp hơn với tình huống hiện tại hơn. ",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": " chẳng hạn xét xem luận điểm nào phù hợp hơn với tình huống hiện tại hơn. ",
              "href": null
            }
          ],
          "color": "default"
        },
        "index": 2
      },
      {
        "object": "block",
        "id": "09c7d257-a4a2-493a-a48e-8a3698386aee",
        "parent": {
          "type": "page_id",
          "page_id": "7c105f49-8bff-404b-b1e1-dcd82a632887"
        },
        "created_time": "2024-11-12T15:35:00.000Z",
        "last_edited_time": "2024-11-16T03:19:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "numbered_list_item",
        "numbered_list_item": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Sau tất cả, nếu chúng ta đều không tin, không sure về phương án của nhau thì mình cần “anh cả” vào việc, ",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Sau tất cả, nếu chúng ta đều không tin, không sure về phương án của nhau thì mình cần “anh cả” vào việc, ",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "“anh cả” ở đây là fact-sự thật",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "“anh cả” ở đây là fact-sự thật",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": ", để tìm được anh này cần có vài phương pháp như: a/b test, interview user, usability test, research, measure,… Ví dụ: team đang thảo luận về phương án thiết kế, hiện đang có 2 option, tuy nhiên option A lại tốt cho ngữ cảnh này, option B lại tốt cho ngữ cảnh kia, nhưng hiện lại không có bất kì dữ liệu nào để chứng minh ngữ cảnh nào có tần suất xảy ra cao hơn >> đành phải chọn một option để release trước và measure thêm, hoặc nếu khả thi thì thực hiện luôn a/b testing.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": ", để tìm được anh này cần có vài phương pháp như: a/b test, interview user, usability test, research, measure,… Ví dụ: team đang thảo luận về phương án thiết kế, hiện đang có 2 option, tuy nhiên option A lại tốt cho ngữ cảnh này, option B lại tốt cho ngữ cảnh kia, nhưng hiện lại không có bất kì dữ liệu nào để chứng minh ngữ cảnh nào có tần suất xảy ra cao hơn >> đành phải chọn một option để release trước và measure thêm, hoặc nếu khả thi thì thực hiện luôn a/b testing.",
              "href": null
            }
          ],
          "color": "default"
        },
        "index": 3
      },
