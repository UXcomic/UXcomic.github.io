        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Việc quan trọng nhất với những thông tin vùng này là biết chọn cái gì để ta nghiền ngẫm thêm. Nếu biết chọn một cách có chiến lược, nó sẽ là nền móng rất tốt để mở rộng nhân sinh quan của chúng ta.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Việc quan trọng nhất với những thông tin vùng này là biết chọn cái gì để ta nghiền ngẫm thêm. Nếu biết chọn một cách có chiến lược, nó sẽ là nền móng rất tốt để mở rộng nhân sinh quan của chúng ta.",
