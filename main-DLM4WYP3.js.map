            {
              "type": "text",
              "text": {
                "content": "Level này sẽ cần bạn",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Level này sẽ cần bạn",
              "href": null
