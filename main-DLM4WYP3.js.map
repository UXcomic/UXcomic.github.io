        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Từ việc bạn đóng tốt vai trò một facilitator, bạn sẽ dần trở thành người đáng tin cậy, dần có tiếng nói hơn vì bạn thể hiện được khả năng dẫn dắt cuộc họp để giúp đội nhóm thảo luận hiệu quả & ra quyết định nhanh chóng. Điều này đặc biệt quan trọng khi bạn ở level middle trở lên.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Từ việc bạn đóng tốt vai trò một facilitator, bạn sẽ dần trở thành người đáng tin cậy, dần có tiếng nói hơn vì bạn thể hiện được khả năng dẫn dắt cuộc họp để giúp đội nhóm thảo luận hiệu quả & ra quyết định nhanh chóng. Điều này đặc biệt quan trọng khi bạn ở level middle trở lên.",
              "href": null
            }
          ],
          "color": "default"
        }
