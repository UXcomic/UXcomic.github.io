      {
        "object": "block",
        "id": "21a5d164-78d8-80f2-9654-d38bcf19e15c",
        "parent": {
          "type": "page_id",
          "page_id": "73bdf5d9-ca49-4b27-89a2-2dde16b2af7d"
        },
        "created_time": "2025-06-22T01:48:00.000Z",
        "last_edited_time": "2025-06-22T01:52:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Một cái thực tế hơn mình thấy rất hay để nói về “top dowm processing” này là metaphor (ẩn dụ), ta dùng những minh hoạ ta đã biết để hiểu một thứ mới tốt hơn, ta dùng những ví dụ để nói về cái mới sẽ khiến ta nắm bắt được vấn đề tốt hơn. Ví dụ: “trái tim sắt đá” ý nói con người thô kệch, vô cảm, vì sao ta nghĩ được thế, vì sắt đá mang trong nó tính chất ấy, nó vô hồn, nó cứng cỏi. Ví dụ ngược lại “uyển chuyển như nước” cho thấy khả năng linh hoạt qua hình thái vượt mọi địa hình.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Một cái thực tế hơn mình thấy rất hay để nói về “top dowm processing” này là metaphor (ẩn dụ), ta dùng những minh hoạ ta đã biết để hiểu một thứ mới tốt hơn, ta dùng những ví dụ để nói về cái mới sẽ khiến ta nắm bắt được vấn đề tốt hơn. Ví dụ: “trái tim sắt đá” ý nói con người thô kệch, vô cảm, vì sao ta nghĩ được thế, vì sắt đá mang trong nó tính chất ấy, nó vô hồn, nó cứng cỏi. Ví dụ ngược lại “uyển chuyển như nước” cho thấy khả năng linh hoạt qua hình thái vượt mọi địa hình.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
