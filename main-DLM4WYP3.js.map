      {
        "object": "block",
        "id": "1475d164-78d8-80e4-a345-d84f8f8bc3c3",
        "parent": {
          "type": "page_id",
          "page_id": "1445d164-78d8-805b-b388-e24b5f13cccb"
        },
        "created_time": "2024-11-23T03:23:00.000Z",
        "last_edited_time": "2024-12-25T02:10:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Khi đã nghiên cứu đủ nhiều bể problem ta sẽ phát hiện ra các cơ hội (giá trị của việc giải quyết problem ấy), nhưng dựa trên resource, tình hình kinh doanh, giai đoạn sản phẩm, chiến lược cạnh tranh hiện tại, các problem sẽ được filter lại, để quyết định xem đâu là cái ta phải làm, đâu là cái ta nên & không nên làm, đâu là cái đáng để đầu tư nhiều, đâu là cái “vừa đủ xài” là được…(kiếm vấn đề để giải quyết không khó, nhưng chọn cái nào để giải quyết mới khó 🤣).",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Khi đã nghiên cứu đủ nhiều bể problem ta sẽ phát hiện ra các cơ hội (giá trị của việc giải quyết problem ấy), nhưng dựa trên resource, tình hình kinh doanh, giai đoạn sản phẩm, chiến lược cạnh tranh hiện tại, các problem sẽ được filter lại, để quyết định xem đâu là cái ta phải làm, đâu là cái ta nên & không nên làm, đâu là cái đáng để đầu tư nhiều, đâu là cái “vừa đủ xài” là được…(kiếm vấn đề để giải quyết không khó, nhưng chọn cái nào để giải quyết mới khó 🤣).",
              "href": null
            }
          ],
          "color": "default"
        }
