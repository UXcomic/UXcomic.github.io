        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Khi đã xong design & hand-off, nhiệm vụ của designer là tiếp tục follow up để support các bên ấy, đôi khi trong xuyên suốt quá trình build & UAT sẽ phát sinh thêm các edge case hoặc vướng thêm vài technical constraint, lúc này designer cần cân nhắc & adapt theo (các constraint nên minor, không ảnh hưởng đến solution concept hay main flow).",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Khi đã xong design & hand-off, nhiệm vụ của designer là tiếp tục follow up để support các bên ấy, đôi khi trong xuyên suốt quá trình build & UAT sẽ phát sinh thêm các edge case hoặc vướng thêm vài technical constraint, lúc này designer cần cân nhắc & adapt theo (các constraint nên minor, không ảnh hưởng đến solution concept hay main flow).",
              "href": null
