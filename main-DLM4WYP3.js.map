            {
              "type": "text",
              "text": {
                "content": "Tại sao phải biến product của bạn thành 1 chàng trai/cô nàng “",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Tại sao phải biến product của bạn thành 1 chàng trai/cô nàng “",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "tâm lý",
                "link": null
              },
              "annotations": {
