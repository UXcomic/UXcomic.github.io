        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "So cố gắng suy nghĩ UI của bạn as a system, tái sử dụng nhiều nhất có thể.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "So cố gắng suy nghĩ UI của bạn as a system, tái sử dụng nhiều nhất có thể.",
              "href": null
