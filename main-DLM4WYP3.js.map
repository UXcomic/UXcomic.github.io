        "type": "bulleted_list_item",
        "bulleted_list_item": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Diễn đạt mối liên hệ phức tạp tốt hơn",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Diễn đạt mối liên hệ phức tạp tốt hơn",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": ". Thử nghĩ xem, khi nói/ đọc/nghe mình sẽ qua từng từ từng câu một, và nó có tính tuyến tính (linear thinking vẫn cần thiết vì nó giúp mình hiểu từng chút - chunking) a => b, b => c, trong khi nhìn hình ảnh, nó không theo kiểu tuyến tính đó, nó theo kiểu mapping, system thinking, mọi thông tin đến theo cụm, quan trọng nhất là nhìn được ",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": ". Thử nghĩ xem, khi nói/ đọc/nghe mình sẽ qua từng từ từng câu một, và nó có tính tuyến tính (linear thinking vẫn cần thiết vì nó giúp mình hiểu từng chút - chunking) a => b, b => c, trong khi nhìn hình ảnh, nó không theo kiểu tuyến tính đó, nó theo kiểu mapping, system thinking, mọi thông tin đến theo cụm, quan trọng nhất là nhìn được ",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "mối liên hệ giữa chúng",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "mối liên hệ giữa chúng",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": ", bạn sẽ gắn kết các “thành phần hình ảnh” ngay tức khắc và hình dung ra một thông điệp gì đó qua vài giây nhìn. Ví dụ: thay vì bạn gửi hình dưới cho người nghe, hãy thử hình dung xem nếu bạn phải diễn tả nó chỉ bằng lời nói, xem có dong dài & đối phương dễ nắm bắt  vấn đề không.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": ", bạn sẽ gắn kết các “thành phần hình ảnh” ngay tức khắc và hình dung ra một thông điệp gì đó qua vài giây nhìn. Ví dụ: thay vì bạn gửi hình dưới cho người nghe, hãy thử hình dung xem nếu bạn phải diễn tả nó chỉ bằng lời nói, xem có dong dài & đối phương dễ nắm bắt  vấn đề không.",
              "href": null
            }
          ],
          "color": "default"
        }
