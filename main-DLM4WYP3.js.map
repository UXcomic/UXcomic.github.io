          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Tất nhiên không phải lúc nào cũng cần nghe ở level cao như vậy, nhưng nếu thật sự bạn muốn tôn trọng & hiểu đối phương thì hãy nhận diện xem mình đang nghe ở level nào & điều chỉnh cho phù hợp.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Tất nhiên không phải lúc nào cũng cần nghe ở level cao như vậy, nhưng nếu thật sự bạn muốn tôn trọng & hiểu đối phương thì hãy nhận diện xem mình đang nghe ở level nào & điều chỉnh cho phù hợp.",
