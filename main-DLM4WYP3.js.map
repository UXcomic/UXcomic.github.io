        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Sự quan sát này cho thấy một chiếc ghế được hình thành tuỳ thuộc vào rất nhiều khía cạnh. Đúng là chỉ để ngồi, mà cách chúng ta ngồi khác nhau, và nhu cầu không chỉ là ngồi, còn lại các thứ xoay quanh như dễ lau chùi, dễ di chuyển, dễ sản xuất…Đó là sự biến đổi A+B = ghế 1, B+C = ghế 2… sự thú vị product là nằm ở ",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Sự quan sát này cho thấy một chiếc ghế được hình thành tuỳ thuộc vào rất nhiều khía cạnh. Đúng là chỉ để ngồi, mà cách chúng ta ngồi khác nhau, và nhu cầu không chỉ là ngồi, còn lại các thứ xoay quanh như dễ lau chùi, dễ di chuyển, dễ sản xuất…Đó là sự biến đổi A+B = ghế 1, B+C = ghế 2… sự thú vị product là nằm ở ",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "it’s depends, ",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "it’s depends, ",
              "href": null
