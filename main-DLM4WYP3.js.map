      {
        "object": "block",
        "id": "1435d164-78d8-80ed-999f-c63b8ab9db5a",
        "parent": {
          "type": "page_id",
          "page_id": "1435d164-78d8-8004-930c-e9f3fede9fe4"
        },
        "created_time": "2024-11-19T11:35:00.000Z",
        "last_edited_time": "2025-05-09T01:39:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Việc câu cá đòi hỏi sự kiên nhẫn cũng như kĩ năng, từ việc chọn mồi câu, cần câu hay vùng nước, xem thời tiết, từ việc bạn đọc tín hiệu cũng giống như nắm tâm lý đối phương, và việc bạn kiểm soát sự kéo thả dây cũng giống như khả năng ứng biến trong cuộc trao đổi, tất cả đều tác động đến kết quả mình trích xuất thông tin.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Việc câu cá đòi hỏi sự kiên nhẫn cũng như kĩ năng, từ việc chọn mồi câu, cần câu hay vùng nước, xem thời tiết, từ việc bạn đọc tín hiệu cũng giống như nắm tâm lý đối phương, và việc bạn kiểm soát sự kéo thả dây cũng giống như khả năng ứng biến trong cuộc trao đổi, tất cả đều tác động đến kết quả mình trích xuất thông tin.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1435d164-78d8-8070-9063-e5052c0fef49",
        "parent": {
          "type": "page_id",
