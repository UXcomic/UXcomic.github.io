          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Là quá trình bạn xử lý, giải nghĩa thông tin dựa trên kiến thức, kinh nghiệm và kỳ vọng ",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Là quá trình bạn xử lý, giải nghĩa thông tin dựa trên kiến thức, kinh nghiệm và kỳ vọng ",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "sẵn có ",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "sẵn có ",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "để có thể hiểu. Quá trình này bắt đầu từ não bộ để áp dụng lên các dữ liệu có được từ giác quan, nó mang tính trực giác & xử lý nhanh nhẹ hơn. Ví dụ: đa phần user biết “kính lúp” đại diện cho search feature.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "để có thể hiểu. Quá trình này bắt đầu từ não bộ để áp dụng lên các dữ liệu có được từ giác quan, nó mang tính trực giác & xử lý nhanh nhẹ hơn. Ví dụ: đa phần user biết “kính lúp” đại diện cho search feature.",
              "href": null
