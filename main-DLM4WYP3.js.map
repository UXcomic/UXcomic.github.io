      {
        "object": "block",
        "id": "16c5d164-78d8-800c-9b14-dd2c36ab91b2",
        "parent": {
          "type": "page_id",
          "page_id": "1575d164-78d8-8024-860e-d419e25be8bc"
        },
        "created_time": "2024-12-30T01:58:00.000Z",
        "last_edited_time": "2024-12-30T01:58:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Người thụ động thường né tránh xung đột, chờ chỉ đạo, và dễ chấp nhận tình huống hơn là thay đổi. Họ thường thiếu sự tự tin để thể hiện ý kiến hoặc đối mặt với rủi ro trong công việc.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Người thụ động thường né tránh xung đột, chờ chỉ đạo, và dễ chấp nhận tình huống hơn là thay đổi. Họ thường thiếu sự tự tin để thể hiện ý kiến hoặc đối mặt với rủi ro trong công việc.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "16c5d164-78d8-80e8-a0a6-f5d6be352571",
        "parent": {
          "type": "page_id",
          "page_id": "1575d164-78d8-8024-860e-d419e25be8bc"
        },
        "created_time": "2024-12-30T01:52:00.000Z",
        "last_edited_time": "2024-12-30T05:16:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": ">> Vì tính nhạy cảm nên nhóm này cần chúng ta động viên, tạo môi trường an toàn để họ chia sẻ, và hỗ trợ họ trong việc ra quyết định. Nhóm này rất dễ chấp nhận nên có khi sẽ thiếu chính kiến, nên phải make sure là khi nhóm này ra quyết định, họ đã trải qua đủ sự cân nhắc & đủ thông tin. Nhóm này cũng ưa chuộng phương án an toàn hơn vì xu hướng nét tránh xung đột, nên cũng nên khuyến khích sự sáng tạo trong họ.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": ">> Vì tính nhạy cảm nên nhóm này cần chúng ta động viên, tạo môi trường an toàn để họ chia sẻ, và hỗ trợ họ trong việc ra quyết định. Nhóm này rất dễ chấp nhận nên có khi sẽ thiếu chính kiến, nên phải make sure là khi nhóm này ra quyết định, họ đã trải qua đủ sự cân nhắc & đủ thông tin. Nhóm này cũng ưa chuộng phương án an toàn hơn vì xu hướng nét tránh xung đột, nên cũng nên khuyến khích sự sáng tạo trong họ.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
