        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Thường khi đã hòm hòm có được design concept nên involve thêm Dev/Engineer vào để check về độ khả thi, có technical constraints, có edge case hay dependencies nào cần aware trước không. (",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Thường khi đã hòm hòm có được design concept nên involve thêm Dev/Engineer vào để check về độ khả thi, có technical constraints, có edge case hay dependencies nào cần aware trước không. (",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "xem thêm bài này",
                "link": {
                  "url": "/10f5d16478d8808484a5d6eff66f3eec"
