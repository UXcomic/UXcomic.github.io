        "public_id": "uxcomic-imgs/1185d164-78d8-8142-9112-e7cfeefe6de7"
      },
      {
        "object": "block",
        "id": "1185d164-78d8-818d-a98b-f070d123e901",
        "parent": {
          "type": "page_id",
          "page_id": "f27ddffd-7a16-46eb-9e41-c71d27945645"
        },
        "created_time": "2024-10-07T05:13:00.000Z",
        "last_edited_time": "2025-01-05T11:22:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Có ai đã nghe qua câu: “nếu một thiết kế tốt, thì nó gần như trở nên vô hình” chưa nhỉ?",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Có ai đã nghe qua câu: “nếu một thiết kế tốt, thì nó gần như trở nên vô hình” chưa nhỉ?",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1725d164-78d8-80dc-9328-fc973e024c40",
        "parent": {
          "type": "page_id",
          "page_id": "f27ddffd-7a16-46eb-9e41-c71d27945645"
        },
        "created_time": "2025-01-05T11:22:00.000Z",
        "last_edited_time": "2025-01-05T11:23:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Mình đã nghe được câu này vài năm trước, nó khơi lên một mình sự tò mò thú vị về một góc nhìn mới trong thiết kế, vì mình thấy nó mâu thuẫn, design không phải lên làm nó lung linh, lộng lẫy, thu hút người xem hay sao mà lại nói tốt có nghĩa là vô hình.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Mình đã nghe được câu này vài năm trước, nó khơi lên một mình sự tò mò thú vị về một góc nhìn mới trong thiết kế, vì mình thấy nó mâu thuẫn, design không phải lên làm nó lung linh, lộng lẫy, thu hút người xem hay sao mà lại nói tốt có nghĩa là vô hình.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1725d164-78d8-80cf-a008-d0c02ab63909",
        "parent": {
          "type": "page_id",
          "page_id": "f27ddffd-7a16-46eb-9e41-c71d27945645"
        },
        "created_time": "2025-01-05T11:23:00.000Z",
        "last_edited_time": "2025-01-07T01:37:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Nhưng qua vài năm làm UX, thực hiện vài buổi testing, hiểu về mental model, interaction cost, mình mới bắt đầu rơi vào Aha moment, hòm hòm thấm được ý nghĩa của câu đó nói về việc gì.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Nhưng qua vài năm làm UX, thực hiện vài buổi testing, hiểu về mental model, interaction cost, mình mới bắt đầu rơi vào Aha moment, hòm hòm thấm được ý nghĩa của câu đó nói về việc gì.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1725d164-78d8-80ff-aad9-e585f0284ebb",
        "parent": {
          "type": "page_id",
          "page_id": "f27ddffd-7a16-46eb-9e41-c71d27945645"
        },
        "created_time": "2025-01-05T11:25:00.000Z",
        "last_edited_time": "2025-01-05T11:25:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
