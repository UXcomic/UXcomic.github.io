      {
        "object": "block",
        "id": "14f5d164-78d8-8012-8554-fab72ed7561a",
        "parent": {
          "type": "page_id",
          "page_id": "ff81ff8a-b21e-4952-a5f7-8e1b1714f022"
        },
        "created_time": "2024-12-01T04:32:00.000Z",
        "last_edited_time": "2024-12-02T03:25:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Còn trong tổ chức thì như thế nào? Thông qua việc tạo điều kiện để các bên ngồi xuống thảo luận & đóng góp ý kiến cho nhau, điều này giúp mọi người đồng thuận với nhau, tránh xung đột, tăng khả năng hợp tác, giúp các member cảm thấy có thêm động lực vì được lắng nghe (chứ không như waterfall, designer chỉ cần thực thi requirement từ PO/PM, dev chỉ cần làm theo design). Cũng nhờ có nhiều góc nhìn hơn, nó khuyến khích được sự sáng tạo & phát hiện được các điểm mù sớm hơn, tránh việc bên trên plan xong thì bên dưới bảo không được.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Còn trong tổ chức thì như thế nào? Thông qua việc tạo điều kiện để các bên ngồi xuống thảo luận & đóng góp ý kiến cho nhau, điều này giúp mọi người đồng thuận với nhau, tránh xung đột, tăng khả năng hợp tác, giúp các member cảm thấy có thêm động lực vì được lắng nghe (chứ không như waterfall, designer chỉ cần thực thi requirement từ PO/PM, dev chỉ cần làm theo design). Cũng nhờ có nhiều góc nhìn hơn, nó khuyến khích được sự sáng tạo & phát hiện được các điểm mù sớm hơn, tránh việc bên trên plan xong thì bên dưới bảo không được.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
