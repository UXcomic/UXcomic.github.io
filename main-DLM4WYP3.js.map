            {
              "type": "text",
              "text": {
                "content": "Khoảng lặng",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Khoảng lặng",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": ": khoảng lặng trong mọi cuộc hội thoại đều rất quan trọng và cần thiết, nó giúp đôi bên có thêm thời gian để sắp xếp lại các thông tin và suy nghĩ về cách phản hồi phù hợp. Riêng trong đàm phán khoảng lặng rất giá trị, việc bạn không gấp gáp trình bày hay phản hồi phần nào đó khiến đối phương thấy được sự tự tin & quyết đoán của bạn, vô tình tạo nên một áp lực tâm lý tích cực.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": ": khoảng lặng trong mọi cuộc hội thoại đều rất quan trọng và cần thiết, nó giúp đôi bên có thêm thời gian để sắp xếp lại các thông tin và suy nghĩ về cách phản hồi phù hợp. Riêng trong đàm phán khoảng lặng rất giá trị, việc bạn không gấp gáp trình bày hay phản hồi phần nào đó khiến đối phương thấy được sự tự tin & quyết đoán của bạn, vô tình tạo nên một áp lực tâm lý tích cực.",
