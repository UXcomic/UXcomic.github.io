              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "xem thêm bài này",
              "href": "/10f5d16478d8808484a5d6eff66f3eec"
            },
            {
              "type": "text",
              "text": {
                "content": " để nắm được chiếc hộp của một designer là gì)",
                "link": null
