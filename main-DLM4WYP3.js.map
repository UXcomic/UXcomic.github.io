      {
        "object": "block",
        "id": "6a8150f2-b255-4446-9f3e-11a25d5d74eb",
        "parent": {
          "type": "page_id",
          "page_id": "ed40fd40-a318-4fd6-a63f-0067b4e54861"
        },
        "created_time": "2024-10-08T02:04:00.000Z",
        "last_edited_time": "2024-12-31T01:47:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "bulleted_list_item",
        "bulleted_list_item": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Việc nhìn nhận được giá trị của design giúp chúng ta làm rõ trách nhiệm & bổ phận của nó, hiểu rằng mình là một mắt xích trong tổ chức, để có thể vừa khiêm tốn, vừa tự tin về công việc của design.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Việc nhìn nhận được giá trị của design giúp chúng ta làm rõ trách nhiệm & bổ phận của nó, hiểu rằng mình là một mắt xích trong tổ chức, để có thể vừa khiêm tốn, vừa tự tin về công việc của design.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "b76fe524-2d70-4c3c-aa61-814979ca51ce",
        "parent": {
          "type": "page_id",
          "page_id": "ed40fd40-a318-4fd6-a63f-0067b4e54861"
        },
        "created_time": "2024-10-08T02:08:00.000Z",
        "last_edited_time": "2024-12-31T01:48:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
