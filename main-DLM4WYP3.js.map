        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Mình sẽ không biết “con cá” sắp cắn câu trông ra sao cho đến khi nó cũng ra được khỏi mặt nước, và cũng không biết “con cá” đó đáng giá thế nào cho đến khi mình cho ra “thị trường” (độ hiếm, độ cần) hoặc có “ngon” hay không (hợp khẩu vị mình hay không).",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Mình sẽ không biết “con cá” sắp cắn câu trông ra sao cho đến khi nó cũng ra được khỏi mặt nước, và cũng không biết “con cá” đó đáng giá thế nào cho đến khi mình cho ra “thị trường” (độ hiếm, độ cần) hoặc có “ngon” hay không (hợp khẩu vị mình hay không).",
              "href": null
            }
          ],
          "color": "default"
        }
