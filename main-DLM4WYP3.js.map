      {
        "object": "block",
        "id": "14d5d164-78d8-80e7-8d95-c22074737098",
        "parent": {
          "type": "page_id",
          "page_id": "f795c7b7-fe0a-4875-9c82-96002d8bbdae"
        },
        "created_time": "2024-11-29T04:52:00.000Z",
        "last_edited_time": "2024-12-20T05:42:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Sau khi đã đánh giá, phê bình được điểm tốt, điểm tệ, hiểu các trade off. Giờ mình sẽ thử hình dung xem có giải pháp cải thiện nào không. Có khi không cần chi tiết mà chỉ cần list out ra những challenge mà design cần phải cân nhắc để giải quyết thêm. Ví dụ: làm sao để không click nhầm, làm sao để tiện lợi hơn, làm sao để user tự tin take action hơn,…",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Sau khi đã đánh giá, phê bình được điểm tốt, điểm tệ, hiểu các trade off. Giờ mình sẽ thử hình dung xem có giải pháp cải thiện nào không. Có khi không cần chi tiết mà chỉ cần list out ra những challenge mà design cần phải cân nhắc để giải quyết thêm. Ví dụ: làm sao để không click nhầm, làm sao để tiện lợi hơn, làm sao để user tự tin take action hơn,…",
              "href": null
            }
          ],
          "color": "default"
        }
