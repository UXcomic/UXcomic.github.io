              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "\"Architecture\" là cách ",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "tổ chức",
                "link": {
                  "url": "/1225d16478d880db8d9be6cc64d11314"
                }
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "tổ chức",
              "href": "/1225d16478d880db8d9be6cc64d11314"
            },
            {
              "type": "text",
              "text": {
                "content": " và sắp xếp thông tin một cách có hệ thống và logic, tương tự như cách một kiến trúc sư xây dựng cấu trúc cho một ngôi nhà vậy. Đó là việc phân chia phòng ốc, thiết kế lối đi, hành lang, và thang máy để mọi người có thể di chuyển dễ dàng trong tòa nhà, cách đặt để các vật dụng trong phòng ra sao cho tiện nghi, quyết định xem nên dùng loại cửa nào, chất liệu ra sao cho phù hợp…",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": " và sắp xếp thông tin một cách có hệ thống và logic, tương tự như cách một kiến trúc sư xây dựng cấu trúc cho một ngôi nhà vậy. Đó là việc phân chia phòng ốc, thiết kế lối đi, hành lang, và thang máy để mọi người có thể di chuyển dễ dàng trong tòa nhà, cách đặt để các vật dụng trong phòng ra sao cho tiện nghi, quyết định xem nên dùng loại cửa nào, chất liệu ra sao cho phù hợp…",
