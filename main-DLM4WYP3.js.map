        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Trước đó UI từng được gọi với cái tên GUI (graphic user interface). UI là giao diện để giao tiếp với user & khi dính đến phần nhìn thì sẽ cần nói đến graphic & visual, nên thấy có chữ graphic trong đó cũng khá đúng.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Trước đó UI từng được gọi với cái tên GUI (graphic user interface). UI là giao diện để giao tiếp với user & khi dính đến phần nhìn thì sẽ cần nói đến graphic & visual, nên thấy có chữ graphic trong đó cũng khá đúng.",
