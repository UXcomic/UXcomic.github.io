          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Nghe thấu cảm (Empathetically listening):",
                "link": null
              },
              "annotations": {
                "bold": true,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Nghe thấu cảm (Empathetically listening):",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": " Chúng ta tập trung và lắng nghe để hiểu rõ ý định đằng sau thông điệp. Đây mới là đỉnh cao của việc nghe, nghe “những gì họ không nói ra”, là lúc bạn quan sát thêm các ngôn ngữ cơ thể của họ, đoán biết tâm lý của họ.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": " Chúng ta tập trung và lắng nghe để hiểu rõ ý định đằng sau thông điệp. Đây mới là đỉnh cao của việc nghe, nghe “những gì họ không nói ra”, là lúc bạn quan sát thêm các ngôn ngữ cơ thể của họ, đoán biết tâm lý của họ.",
              "href": null
            }
          ],
          "color": "default"
        },
        "index": 4
