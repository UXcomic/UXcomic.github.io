      {
        "object": "block",
        "id": "16a5d164-78d8-806c-8d0b-ff48f646d3dc",
        "parent": {
          "type": "page_id",
          "page_id": "32cbe568-c34b-4255-a408-f2a2e6227bb2"
        },
        "created_time": "2024-12-28T03:37:00.000Z",
        "last_edited_time": "2024-12-28T03:40:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Trên đời có rất nhiều nhiều món ăn, thức uống. Theo thời gian bạn sẽ thử được món này món kia, quán này quán kia (thế giới quan), bạn sẽ đánh giá được món nào ngon món nào không (giá trị quan), tuy nhiên sau khi thử rất nhiều món bạn nhận ra mình vẫn thích món quê nhà hơn (nhân sinh quan). Nhân sinh quan có thể sẽ tác động lên xu hướng ăn uống của bạn.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Trên đời có rất nhiều nhiều món ăn, thức uống. Theo thời gian bạn sẽ thử được món này món kia, quán này quán kia (thế giới quan), bạn sẽ đánh giá được món nào ngon món nào không (giá trị quan), tuy nhiên sau khi thử rất nhiều món bạn nhận ra mình vẫn thích món quê nhà hơn (nhân sinh quan). Nhân sinh quan có thể sẽ tác động lên xu hướng ăn uống của bạn.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
