        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "\"Garbage in, garbage out,\" is a popular truth, often said in relation to computer systems: if you put the wrong information in, you'll get the wrong information out.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "\"Garbage in, garbage out,\" is a popular truth, often said in relation to computer systems: if you put the wrong information in, you'll get the wrong information out.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1605d164-78d8-80dd-acdc-ded127f7a89c",
        "parent": {
          "type": "page_id",
          "page_id": "1605d164-78d8-80c3-b322-f577530e7916"
        },
        "created_time": "2024-12-18T02:09:00.000Z",
        "last_edited_time": "2024-12-18T02:09:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "The same principle applies to communications in general: if you ask the wrong questions, you'll probably get the wrong answer, or at least not quite what you're hoping for.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "The same principle applies to communications in general: if you ask the wrong questions, you'll probably get the wrong answer, or at least not quite what you're hoping for.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
