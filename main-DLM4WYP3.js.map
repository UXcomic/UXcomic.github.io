      {
        "object": "block",
        "id": "22e5d164-78d8-8090-9176-fe50edd7d739",
        "parent": {
          "type": "page_id",
          "page_id": "22e5d164-78d8-80a5-add3-ed7cd93f001b"
        },
        "created_time": "2025-07-12T12:20:00.000Z",
        "last_edited_time": "2025-07-12T12:22:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "“Tương tác” là quá trình có sự tác động giữa hai hoặc nhiều bên. Từ cái basic này, nhìn chuyên môn hơn chút chữ “interaction” trong Interaction design (trước đó là HCI - human computer interaction) là quá trình tác động qua lại giữa người và máy, quá trình này diễn ra khi con người tiếp nhận gì đó từ máy (vd: thấy cái gì) rồi tác động vô máy (vd: click chuột vào một folder) thì máy phản hồi lại (mở folder) >> đây là một tương tác.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "“Tương tác” là quá trình có sự tác động giữa hai hoặc nhiều bên. Từ cái basic này, nhìn chuyên môn hơn chút chữ “interaction” trong Interaction design (trước đó là HCI - human computer interaction) là quá trình tác động qua lại giữa người và máy, quá trình này diễn ra khi con người tiếp nhận gì đó từ máy (vd: thấy cái gì) rồi tác động vô máy (vd: click chuột vào một folder) thì máy phản hồi lại (mở folder) >> đây là một tương tác.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
