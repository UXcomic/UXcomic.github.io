                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Như có nói ở trên, từ information đến wisdom đến chịu tác động chủ quan hay cụ thể hơn thì nó là perception. ",
              "href": null
            },
            {
              "type": "text",
              "text": {
                "content": "Perception (nhận thức): ",
                "link": null
              },
              "annotations": {
