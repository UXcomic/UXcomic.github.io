          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Như mình thấy top-down process sẽ giúp mình giải nghĩa nhanh hơn vì dựa trên những kiến thức sẵn có, cón bottom-up thì sẽ take mental effort hơn vì cần phải học.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Như mình thấy top-down process sẽ giúp mình giải nghĩa nhanh hơn vì dựa trên những kiến thức sẵn có, cón bottom-up thì sẽ take mental effort hơn vì cần phải học.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
