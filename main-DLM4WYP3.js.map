        "parent": {
          "type": "page_id",
          "page_id": "95727332-bdb3-4f63-a0cd-f9023732995d"
        },
        "created_time": "2024-11-19T01:32:00.000Z",
        "last_edited_time": "2025-05-21T05:56:00.000Z",
        "created_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "last_edited_by": {
          "object": "user",
          "id": "ab24e3a0-5d07-4c0e-8ddf-b9d9eda19bf9"
        },
        "has_children": false,
        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Khi bạn đang suy nghĩ về một câu hỏi, nó sẽ tạm đóng băng các luồng suy nghĩ khác để nhường lại sự tập trung tìm cho việc tìm câu trả lời.",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Khi bạn đang suy nghĩ về một câu hỏi, nó sẽ tạm đóng băng các luồng suy nghĩ khác để nhường lại sự tập trung tìm cho việc tìm câu trả lời.",
              "href": null
            }
          ],
          "color": "default"
        }
      },
      {
        "object": "block",
        "id": "1435d164-78d8-8072-9e9f-e462bfaad68e",
        "parent": {
          "type": "page_id",
          "page_id": "95727332-bdb3-4f63-a0cd-f9023732995d"
