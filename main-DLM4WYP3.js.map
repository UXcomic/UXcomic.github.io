        "archived": false,
        "in_trash": false,
        "type": "paragraph",
        "paragraph": {
          "rich_text": [
            {
              "type": "text",
              "text": {
                "content": "Mình tình cờ xem được clip này của Apple nói về các design principle. Thật sự rất hữu ích, đó là tất cả những consideration cần thì come up một design. ",
                "link": null
              },
              "annotations": {
                "bold": false,
                "italic": false,
                "strikethrough": false,
                "underline": false,
                "code": false,
                "color": "default"
              },
              "plain_text": "Mình tình cờ xem được clip này của Apple nói về các design principle. Thật sự rất hữu ích, đó là tất cả những consideration cần thì come up một design. ",
              "href": null
            }
          ],
          "color": "default"
        }
